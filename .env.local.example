# ─────────────────────────────────────────────────────────────────────────────
# THE NON LOCALS — Environment Variables Template
# Copy this file to .env.local and fill in your Firebase project values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Web App config (safe to expose in browser bundle — NEXT_PUBLIC_ prefix)
# Find these in: Firebase Console → Project Settings → Your Apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK credentials — NEVER use NEXT_PUBLIC_ prefix for these.
# These are only used in Cloud Functions / server-side provisioning scripts.
# Store them in Firebase Functions config or Google Secret Manager.
# ─────────────────────────────────────────────────────────────────────────────
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

